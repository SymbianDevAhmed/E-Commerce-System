    {
      "name": "Get Products",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Products include Laptop with the correct discounted price\", function () {\r\n    const products = pm.response.json();\r\n    pm.expect(products).to.be.an(\"array\");\r\n\r\n    const laptop = products.find(product => product.id === 1);\r\n    pm.expect(laptop, \"Laptop with ID 1\").to.be.an(\"object\");\r\n    pm.expect(laptop.name).to.eql(\"Laptop\");\r\n    pm.expect(laptop.finalPrice).to.eql(27000);\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://127.0.0.1:8080/products",
          "protocol": "http",
          "host": [
