    {
      "name": "Get Customer Orders",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Customer orders return 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Order 1 has the expected total\", function () {\r\n    const orders = pm.response.json();\r\n    pm.expect(orders).to.be.an(\"array\");\r\n\r\n    const order = orders.find(item => item.id === 1);\r\n    pm.expect(order, \"Order 1\").to.be.an(\"object\");\r\n    pm.expect(order.total).to.eql(54000);\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
